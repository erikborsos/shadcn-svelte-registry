	"files": [
		{
			"content": "import AppShell from \"./app-shell.svelte\"\nimport AppHeader from \"./app-header.svelte\"\nimport DocsSidebar from \"./docs-sidebar.svelte\"\nimport TableOfContents from \"./table-of-contents.svelte\"\n\nexport type { AppShellProps, NavLink, SidebarGroup, SearchConfig, TocItem } from \"./types.ts\"\n\nexport { AppHeader, DocsSidebar, TableOfContents }\nexport default AppShell\n",
			"type": "registry:block",
			"target": "index.ts"
		},
		{
			"content": "import type { Snippet } from \"svelte\"\n\nexport type NavLink = {\n\tlabel: string\n\thref: string\n}\n\nexport type SidebarGroup = {\n\tlabel: string\n\thref?: string\n\titems?: {\n\t\tlabel: string\n\t\thref: string\n\t}[]\n}\n\nexport type SearchConfig = {\n\tplaceholder: string\n\tshortPlaceholder?: string\n\tonSearch: () => void\n}\n\nexport type TocItem = {\n\ttitle: string\n\turl: string\n\tdepth: number\n}\n\nexport type AppShellProps = {\n\tchildren: Snippet\n\t/** Links rendered in the header. */\n\tnav?: NavLink[]\n\t/** Groups rendered in the sidebar. */\n\tsidebar?: SidebarGroup[]\n\t/** Header search button. Omit to hide it. */\n\tsearch?: SearchConfig\n\t/** GitHub repository URL. Omit to hide the icon. */\n\tgithub?: string\n\t/** Custom logo for the header home button. */\n\tlogo?: Snippet\n\t/** Home URL used by the header logo button. Defaults to \"/\". */\n\thome?: string\n\t/** Show the \"on this page\" table of contents. Defaults to true. */\n\ttoc?: boolean\n}\n",
			"type": "registry:block",
			"target": "types.ts"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { setContext } from \"svelte\"\n\timport AppHeader from \"./app-header.svelte\"\n\timport DocsSidebar from \"./docs-sidebar.svelte\"\n\timport TableOfContents from \"./table-of-contents.svelte\"\n\timport * as Sidebar from \"$lib/components/ui/sidebar\"\n\timport type { AppShellProps, TocItem } from \"./types.ts\"\n\n\tlet {\n\t\tchildren,\n\t\tnav = [],\n\t\tsidebar = [],\n\t\tsearch,\n\t\tgithub,\n\t\tlogo,\n\t\thome,\n\t\ttoc = true\n\t}: AppShellProps = $props()\n\n\tlet tocItems = $state<TocItem[]>([])\n\n\tsetContext(\"setToc\", (items: TocItem[]) => {\n\t\ttocItems = items\n\t})\n</script>\n\n<Sidebar.Provider>\n\t<div class=\"flex min-h-screen w-full flex-col\">\n\t\t<AppHeader {nav} {search} {github} {logo} {home} />\n\t\t<div class=\"flex flex-1 px-2\">\n\t\t\t<DocsSidebar items={sidebar} />\n\t\t\t<main class=\"flex min-w-0 flex-1\">\n\t\t\t\t<div\n\t\t\t\t\tclass=\"mx-auto flex w-full max-w-3xl min-w-0 flex-1 flex-col gap-6 px-4 py-6 md:px-0 lg:py-8\"\n\t\t\t\t>\n\t\t\t\t\t{@render children()}\n\t\t\t\t</div>\n\t\t\t\t{#if toc && tocItems.length}\n\t\t\t\t\t<div\n\t\t\t\t\t\tclass=\"fixed top-24 right-0 z-30 hidden h-[calc(100svh-6rem)] w-72 flex-col gap-4 overscroll-none pr-4 pb-8 xl:flex\"\n\t\t\t\t\t>\n\t\t\t\t\t\t<TableOfContents toc={tocItems} />\n\t\t\t\t\t</div>\n\t\t\t\t{/if}\n\t\t\t</main>\n\t\t</div>\n\t</div>\n</Sidebar.Provider>\n",
			"type": "registry:component",
			"target": "app-shell.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n\timport type { Snippet } from \"svelte\"\n\timport type { NavLink, SearchConfig } from \"./types.ts\"\n\n\texport type Props = {\n\t\tnav?: NavLink[]\n\t\tsearch?: SearchConfig\n\t\tgithub?: string\n\t\tlogo?: Snippet\n\t\thome?: string\n\t}\n</script>\n\n<script lang=\"ts\">\n\timport Button from \"$lib/components/ui/button/button.svelte\"\n\timport * as Sidebar from \"$lib/components/ui/sidebar\"\n\timport ThemeSwitcher from \"./theme-switcher.svelte\"\n\timport Github from \"./github.svelte\"\n\timport Shadcn from \"./shadcn.svelte\"\n\timport { cn } from \"$UTILS$\"\n\n\tlet { nav = [], search, github, logo, home = \"/\" }: Props = $props()\n</script>\n\n<header class=\"sticky top-0 z-50 w-full bg-background/80 py-2 backdrop-blur-md\">\n\t<div class=\"px-6\">\n\t\t<div class=\"flex h-13 items-center **:data-[slot=separator]:h-4!\">\n\t\t\t<Sidebar.Trigger class=\"lg:hidden\" />\n\t\t\t<Button class=\"hidden lg:flex\" variant=\"ghost\" size=\"icon\" href={home}>\n\t\t\t\t{#if logo}\n\t\t\t\t\t{@render logo()}\n\t\t\t\t{:else}\n\t\t\t\t\t<Shadcn />\n\t\t\t\t{/if}\n\t\t\t</Button>\n\t\t\t<nav class=\"hidden items-center gap-0 lg:flex\">\n\t\t\t\t{#each nav as link (link.label)}\n\t\t\t\t\t<Button size=\"sm\" variant=\"ghost\" href={link.href}>{link.label}</Button>\n\t\t\t\t{/each}\n\t\t\t</nav>\n\t\t\t<div class=\"ml-auto flex items-center gap-2\">\n\t\t\t\t{#if search}\n\t\t\t\t\t<Button\n\t\t\t\t\t\tvariant=\"outline\"\n\t\t\t\t\t\tclass={cn(\n\t\t\t\t\t\t\t\"relative h-8 justify-start rounded-lg border-none bg-muted pl-3 text-foreground shadow-none transition-colors hover:bg-muted/50 md:w-48 lg:w-40 xl:w-64 dark:bg-card\"\n\t\t\t\t\t\t)}\n\t\t\t\t\t\tonclick={() => search.onSearch()}\n\t\t\t\t\t>\n\t\t\t\t\t\t<span class=\"hidden xl:inline-flex\">{search.placeholder}</span>\n\t\t\t\t\t\t<span class=\"inline-flex xl:hidden\">\n\t\t\t\t\t\t\t{search.shortPlaceholder ?? search.placeholder}</span\n\t\t\t\t\t\t>\n\t\t\t\t\t</Button>\n\t\t\t\t{/if}\n\t\t\t\t{#if github}\n\t\t\t\t\t<Button variant=\"ghost\" size=\"icon-sm\" href={github} target=\"_blank\">\n\t\t\t\t\t\t<Github />\n\t\t\t\t\t</Button>\n\t\t\t\t{/if}\n\t\t\t\t<ThemeSwitcher />\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</header>\n",
			"type": "registry:component",
			"target": "app-header.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport * as Sidebar from \"$lib/components/ui/sidebar\"\n\timport { page } from \"$app/state\"\n\timport type { SidebarGroup } from \"./types.ts\"\n\n\tlet { items = [] }: { items: SidebarGroup[] } = $props()\n</script>\n\n<Sidebar.Root\n\tclass=\"fixed top-16 hidden h-[calc(100svh-4rem)] w-60 shrink-0 flex-col overscroll-none bg-transparent lg:flex\"\n\tcollapsible=\"none\"\n>\n\t<Sidebar.Content class=\"no-scrollbar gap-0 overflow-auto px-2 py-4\">\n\t\t{#each items as group (group.label)}\n\t\t\t<Sidebar.Group>\n\t\t\t\t{#if group.href}\n\t\t\t\t\t<Sidebar.MenuButton isActive={page.url.pathname === group.href}>\n\t\t\t\t\t\t{#snippet child({ props })}\n\t\t\t\t\t\t\t<a href={group.href} {...props}>{group.label}</a>\n\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t</Sidebar.MenuButton>\n\t\t\t\t{:else}\n\t\t\t\t\t<Sidebar.GroupLabel>{group.label}</Sidebar.GroupLabel>\n\t\t\t\t{/if}\n\t\t\t\t{#if group.items?.length}\n\t\t\t\t\t<Sidebar.GroupContent>\n\t\t\t\t\t\t<Sidebar.Menu>\n\t\t\t\t\t\t\t<Sidebar.MenuSub>\n\t\t\t\t\t\t\t\t{#each group.items as item (item.href)}\n\t\t\t\t\t\t\t\t\t<Sidebar.MenuSubItem>\n\t\t\t\t\t\t\t\t\t\t<Sidebar.MenuSubButton isActive={page.url.pathname === item.href}>\n\t\t\t\t\t\t\t\t\t\t\t{#snippet child({ props })}\n\t\t\t\t\t\t\t\t\t\t\t\t<a href={item.href} {...props}>{item.label}</a>\n\t\t\t\t\t\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t\t\t\t\t\t</Sidebar.MenuSubButton>\n\t\t\t\t\t\t\t\t\t</Sidebar.MenuSubItem>\n\t\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t\t</Sidebar.MenuSub>\n\t\t\t\t\t\t</Sidebar.Menu>\n\t\t\t\t\t</Sidebar.GroupContent>\n\t\t\t\t{/if}\n\t\t\t</Sidebar.Group>\n\t\t{/each}\n\t</Sidebar.Content>\n</Sidebar.Root>\n",
			"type": "registry:component",
			"target": "docs-sidebar.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { onMount } from \"svelte\"\n\timport type { TocItem } from \"./types.ts\"\n\n\tlet { toc = [], title = \"On This Page\" }: { toc: TocItem[]; title?: string } = $props()\n\n\tlet activeId = $state<string | null>(null)\n\n\tonMount(() => {\n\t\tconst itemIds = toc.map((item) => item.url.replace(\"#\", \"\"))\n\n\t\tconst observer = new IntersectionObserver(\n\t\t\t(entries) => {\n\t\t\t\tfor (const entry of entries) {\n\t\t\t\t\tif (entry.isIntersecting) {\n\t\t\t\t\t\tactiveId = entry.target.id\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t},\n\t\t\t{ rootMargin: \"0% 0% -80% 0%\" }\n\t\t)\n\n\t\tfor (const id of itemIds) {\n\t\t\tconst element = document.getElementById(id)\n\t\t\tif (element) observer.observe(element)\n\t\t}\n\n\t\treturn () => {\n\t\t\tfor (const id of itemIds) {\n\t\t\t\tconst element = document.getElementById(id)\n\t\t\t\tif (element) observer.unobserve(element)\n\t\t\t}\n\t\t}\n\t})\n</script>\n\n{#if toc.length}\n\t<div class=\"no-scrollbar flex flex-1 flex-col gap-2 overflow-y-auto p-4 pt-0 text-sm\">\n\t\t<p class=\"sticky top-0 h-6 bg-background text-xs font-medium text-muted-foreground\">\n\t\t\t{title}\n\t\t</p>\n\t\t{#each toc as item (item.url)}\n\t\t\t<a\n\t\t\t\thref={item.url}\n\t\t\t\tclass=\"text-[0.8rem] text-muted-foreground no-underline transition-colors hover:text-foreground data-[active=true]:font-medium data-[active=true]:text-foreground\"\n\t\t\t\tdata-active={item.url === `#${activeId}`}\n\t\t\t\tstyle:padding-left=\"{(item.depth - 2) * 1}rem\"\n\t\t\t>\n\t\t\t\t{item.title}\n\t\t\t</a>\n\t\t{/each}\n\t</div>\n{/if}\n",
			"type": "registry:component",
			"target": "table-of-contents.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport Button from \"$lib/components/ui/button/button.svelte\"\n\timport MoonIcon from \"@lucide/svelte/icons/moon\"\n\timport SunIcon from \"@lucide/svelte/icons/sun\"\n\n\timport { toggleMode } from \"mode-watcher\"\n</script>\n\n<Button onclick={toggleMode} variant=\"ghost\" size=\"icon-sm\">\n\t<SunIcon\n\t\tclass=\"h-[1.2rem] w-[1.2rem] scale-100 rotate-0 transition-all! dark:scale-0 dark:-rotate-90\"\n\t/>\n\t<MoonIcon\n\t\tclass=\"absolute h-[1.2rem] w-[1.2rem] scale-0 rotate-90 transition-all! dark:scale-100 dark:rotate-0\"\n\t/>\n\t<span class=\"sr-only\">Toggle theme</span>\n</Button>\n",
			"type": "registry:component",
			"target": "theme-switcher.svelte"
		},
		{
			"content": "<script lang=\"ts\"></script>\n\n<svg viewBox=\"0 0 1024 1024\" fill=\"none\"\n\t><path\n\t\tfill-rule=\"evenodd\"\n\t\tclip-rule=\"evenodd\"\n\t\td=\"M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z\"\n\t\ttransform=\"scale(64)\"\n\t\tfill=\"currentColor\"\n\t/></svg\n>\n",
			"type": "registry:component",
			"target": "github.svelte"
		},
		{
			"content": "<script lang=\"ts\"></script>\n\n<svg viewBox=\"0 0 256 256\"\n\t><path fill=\"none\" d=\"M0 0h256v256H0z\" /><path\n\t\tfill=\"none\"\n\t\tstroke=\"currentColor\"\n\t\tstroke-width=\"25\"\n\t\tstroke-linecap=\"round\"\n\t\td=\"M208 128l-80 80M192 40L40 192\"\n\t/></svg\n>\n",
