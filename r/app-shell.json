		{
			"content": "<script lang=\"ts\">\n\timport { setContext } from \"svelte\"\n\timport { base } from \"$app/paths\"\n\timport AppHeader from \"./app-header.svelte\"\n\timport DocsSidebar from \"./docs-sidebar.svelte\"\n\timport TableOfContents from \"./table-of-contents.svelte\"\n\timport * as Sidebar from \"$lib/components/ui/sidebar\"\n\timport { sidebarItems } from \"$lib/registry\"\n\n\tlet { children } = $props()\n\n\tlet toc = $state<{ title: string; url: string; depth: number }[]>([])\n\n\tsetContext(\"setToc\", (items: { title: string; url: string; depth: number }[]) => {\n\t\ttoc = items\n\t})\n</script>\n\n<Sidebar.Provider>\n\t<div class=\"flex min-h-screen w-full flex-col\">\n\t\t<AppHeader\n\t\t\tshortcuts={[\n\t\t\t\t{ label: \"Docs\", href: `${base}/docs` },\n\t\t\t\t{ label: \"Components\", href: `${base}/docs/components` }\n\t\t\t]}\n\t\t\tsearch={{\n\t\t\t\tplaceholder: \"Search documentation...\",\n\t\t\t\tshortPlaceholder: \"Search...\",\n\t\t\t\tonSearch: () => {}\n\t\t\t}}\n\t\t\tgithub=\"https://github.com/erikborsos/shadcn-svelte-registry\"\n\t\t/>\n\t\t<div class=\"flex flex-1 px-2\">\n\t\t\t<DocsSidebar items={sidebarItems} />\n\t\t\t<main class=\"flex min-w-0 flex-1\">\n\t\t\t\t<div\n\t\t\t\t\tclass=\"mx-auto flex w-full max-w-3xl min-w-0 flex-1 flex-col gap-6 px-4 py-6 md:px-0 lg:py-8\"\n\t\t\t\t>\n\t\t\t\t\t{@render children()}\n\t\t\t\t</div>\n\t\t\t\t{#if toc.length}\n\t\t\t\t\t<div\n\t\t\t\t\t\tclass=\"fixed top-24 right-0 z-30 hidden h-[calc(100svh-6rem)] w-[calc(var(--spacing)*72)] flex-col gap-4 overscroll-none pr-4 pb-8 xl:flex\"\n\t\t\t\t\t>\n\t\t\t\t\t\t<TableOfContents {toc} />\n\t\t\t\t\t</div>\n\t\t\t\t{/if}\n\t\t\t</main>\n\t\t</div>\n\t</div>\n</Sidebar.Provider>\n",
			"type": "registry:component",
			"target": "app-shell.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n\texport type Props = {\n\t\tshortcuts: { label: string; href: string }[]\n\t\tsearch?: { placeholder: string; shortPlaceholder?: string; onSearch: () => void }\n\t\tgithub?: string\n\t}\n</script>\n\n<script lang=\"ts\">\n\timport Button from \"$lib/components/ui/button/button.svelte\"\n\timport * as Sidebar from \"$lib/components/ui/sidebar\"\n\timport ThemeSwitcher from \"./theme-switcher.svelte\"\n\timport Github from \"./github.svelte\"\n\timport Shadnc from \"./shadnc.svelte\"\n\timport { cn } from \"$UTILS$\"\n\timport { base } from \"$app/paths\"\n\n\tlet { shortcuts, search, github }: Props = $props()\n</script>\n\n<header class=\"sticky top-0 z-50 w-full bg-background/80 py-2 backdrop-blur-md\">\n\t<div class=\"px-6\">\n\t\t<div class=\"flex h-13 items-center **:data-[slot=separator]:h-4!\">\n\t\t\t<Sidebar.Trigger class=\"lg:hidden\" />\n\t\t\t<Button class=\"hidden lg:flex\" variant=\"ghost\" size=\"icon\" href={base || \"/\"}>\n\t\t\t\t<Shadnc />\n\t\t\t</Button>\n\t\t\t<nav class=\"hidden items-center gap-0 lg:flex\">\n\t\t\t\t{#each shortcuts as shortcut (shortcut.label)}\n\t\t\t\t\t<Button size=\"sm\" variant=\"ghost\" href={shortcut.href}>{shortcut.label}</Button>\n\t\t\t\t{/each}\n\t\t\t</nav>\n\t\t\t<div class=\"ml-auto flex items-center gap-2\">\n\t\t\t\t{#if search}\n\t\t\t\t\t<Button\n\t\t\t\t\t\tvariant=\"outline\"\n\t\t\t\t\t\tclass={cn(\n\t\t\t\t\t\t\t\"relative h-8 justify-start rounded-lg border-none bg-muted pl-3 text-foreground shadow-none transition-colors hover:bg-muted/50 md:w-48 lg:w-40 xl:w-64 dark:bg-card\"\n\t\t\t\t\t\t)}\n\t\t\t\t\t\tonclick={() => search.onSearch()}\n\t\t\t\t\t>\n\t\t\t\t\t\t<span class=\"hidden xl:inline-flex\">{search.placeholder}</span>\n\t\t\t\t\t\t<span class=\"inline-flex xl:hidden\">\n\t\t\t\t\t\t\t{search.shortPlaceholder ?? search.placeholder}</span\n\t\t\t\t\t\t>\n\t\t\t\t\t</Button>\n\t\t\t\t{/if}\n\t\t\t\t{#if github}\n\t\t\t\t\t<Button variant=\"ghost\" size=\"icon-sm\" href={github} target=\"_blank\">\n\t\t\t\t\t\t<Github />\n\t\t\t\t\t</Button>\n\t\t\t\t{/if}\n\t\t\t\t<ThemeSwitcher />\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</header>\n",
