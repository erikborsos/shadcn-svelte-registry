		{
			"content": "<script lang=\"ts\">\n\timport * as Sidebar from \"$lib/components/ui/sidebar\"\n\timport { page } from \"$app/state\"\n\n\tlet {\n\t\titems = []\n\t}: { items: { label: string; href?: string; items?: { label: string; href: string }[] }[] } =\n\t\t$props()\n</script>\n\n<Sidebar.Root\n\tclass=\"fixed top-16 hidden h-[calc(100svh-4rem)] w-[calc(var(--spacing)*60)] shrink-0 flex-col overscroll-none bg-transparent lg:flex\"\n\tcollapsible=\"none\"\n>\n\t<Sidebar.Content class=\"no-scrollbar gap-0 overflow-auto px-2 py-4\">\n\t\t{#each items as group}\n\t\t\t<Sidebar.Group>\n\t\t\t\t{#if group.href}\n\t\t\t\t\t<Sidebar.MenuButton isActive={page.url.pathname === group.href}>\n\t\t\t\t\t\t{#snippet child({ props })}\n\t\t\t\t\t\t\t<a href={group.href} {...props}>{group.label}</a>\n\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t</Sidebar.MenuButton>\n\t\t\t\t{:else}\n\t\t\t\t\t<Sidebar.GroupLabel>{group.label}</Sidebar.GroupLabel>\n\t\t\t\t{/if}\n\t\t\t\t{#if group.items?.length}\n\t\t\t\t\t<Sidebar.GroupContent>\n\t\t\t\t\t\t<Sidebar.Menu>\n\t\t\t\t\t\t\t<Sidebar.MenuSub>\n\t\t\t\t\t\t\t\t{#each group.items as item}\n\t\t\t\t\t\t\t\t\t<Sidebar.MenuSubItem>\n\t\t\t\t\t\t\t\t\t\t<Sidebar.MenuSubButton isActive={page.url.pathname === item.href}>\n\t\t\t\t\t\t\t\t\t\t\t{#snippet child({ props })}\n\t\t\t\t\t\t\t\t\t\t\t\t<a href={item.href} {...props}>{item.label}</a>\n\t\t\t\t\t\t\t\t\t\t\t{/snippet}\n\t\t\t\t\t\t\t\t\t\t</Sidebar.MenuSubButton>\n\t\t\t\t\t\t\t\t\t</Sidebar.MenuSubItem>\n\t\t\t\t\t\t\t\t{/each}\n\t\t\t\t\t\t\t</Sidebar.MenuSub>\n\t\t\t\t\t\t</Sidebar.Menu>\n\t\t\t\t\t</Sidebar.GroupContent>\n\t\t\t\t{/if}\n\t\t\t</Sidebar.Group>\n\t\t{/each}\n\t</Sidebar.Content>\n</Sidebar.Root>\n",
			"type": "registry:component",
			"target": "docs-sidebar.svelte"
